{
	"name": "cover-2",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts --target=node --outfile=dist/index.js --format=esm",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"format": "bunx biome format --write .",
		"all": "bun run lint && bun run test && bun run build"
	},
	"dependencies": {
		"@actions/core": "^1.10.1",
		"@actions/github": "^6.0.0",
		"@actions/glob": "^0.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^20.11.0",
		"typescript": "^5.3.0"
	},
	"trustedDependencies": ["@biomejs/biome"]
}
